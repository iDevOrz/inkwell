# HTTP
BIND_ADDR=127.0.0.1:3000
SITE_URL=http://127.0.0.1:3000
DATA_DIR=./data
# DATABASE_URL=sqlite://./data/inkwell.db  (default; an existing typecho.db is still used)

# First run only. If omitted, a random password is printed to the log.
ADMIN_USER=admin
ADMIN_PASSWORD=

# HTTP MCP bearer token. Leave empty to disable env-token access;
# you can still create per-client tokens in /admin/tokens.
MCP_TOKEN=
MCP_TOKEN_SCOPES=read,write,review

# Cookies are automatically Secure when SITE_URL starts with https://.
# COOKIE_SECURE=true
# Enable only when the app is reachable exclusively through a trusted proxy
# that overwrites X-Forwarded-For / X-Real-IP.
# TRUST_PROXY_HEADERS=false
# SESSION_DAYS=14
# MAX_UPLOAD_BYTES=10485760
# RUST_LOG=inkwell=info,tower_http=info
